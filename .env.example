# Copy this file to .env and replace every placeholder.

# PostgreSQL database connection.
# Local example: postgresql://postgres:password@localhost:5432/postgres
# Supabase + Render: use the Session pooler URL from the Supabase Connect panel.
DATABASE_URL=postgresql://user:password@host:port/your_db_name

# Initial instructor password. Production requires at least 12 characters.
# It bootstraps the database account on first login.
ADMIN_PASSWORD=replace-with-a-strong-password

# Production requires two different values of at least 32 characters.
# Generate them independently with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-value
GUEST_TRIAL_JWT_SECRET=replace-with-a-different-long-random-value

# Temporary, in-memory guest trial.
GUEST_TRIAL_ENABLED=true
GUEST_TRIAL_TTL_MINUTES=20
GUEST_TRIAL_MAX_PARTICIPANTS=8
GUEST_TRIAL_MAX_CONCURRENT=25
GUEST_TRIAL_STARTS_PER_IP_HOUR=5

# Hosted service guardrails. Hosted instructor accounts get one open room at a
# time and the configured participant limit. Keep false for unrestricted self-hosting.
HOSTED_MODE=false
HOSTED_MAX_PARTICIPANTS=50
# Master-created one-time account links expire after this many hours (max 168).
HOSTED_INVITE_TTL_HOURS=72

# Public hosted registration. Keep disabled until email, sandbox Checkout, and
# webhook delivery have been verified end to end.
PUBLIC_SIGNUP_ENABLED=false
RESEND_API_KEY=re_replace_me
# The From address must belong to the verified Resend domain. Replies go to the
# customer-support mailbox on the primary domain.
EMAIL_FROM=Markdown Mash <info@mail.markdownmash.com>
EMAIL_REPLY_TO=info@markdownmash.com

# Annual Stripe billing for Markdown Mash Hosted. Leave disabled until the
# sandbox Product, yearly Price, Customer Portal, and webhook are configured.
STRIPE_BILLING_ENABLED=false
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID=price_replace_me
# Canonical public origin used for Stripe returns and verification links.
APP_BASE_URL=http://localhost:3000

# Use production on a public deployment.
NODE_ENV=development

# Server Port (Optional - Render sets this automatically)
# PORT=3000
