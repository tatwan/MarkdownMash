# Copy this file to .env and replace every placeholder.

# PostgreSQL database connection.
# Local example: postgresql://postgres:password@localhost:5432/postgres
# Supabase + Render: use the Session pooler URL from the Supabase Connect panel.
DATABASE_URL=postgresql://user:password@host:port/your_db_name

# Initial instructor password. Production requires at least 12 characters.
# It bootstraps the database account on first login.
ADMIN_PASSWORD=replace-with-a-strong-password

# Production requires two different values of at least 32 characters.
# Generate them independently with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-value
GUEST_TRIAL_JWT_SECRET=replace-with-a-different-long-random-value

# Temporary, in-memory guest trial.
GUEST_TRIAL_ENABLED=true
GUEST_TRIAL_TTL_MINUTES=20
GUEST_TRIAL_MAX_PARTICIPANTS=8
GUEST_TRIAL_MAX_CONCURRENT=25
GUEST_TRIAL_STARTS_PER_IP_HOUR=5

# Hosted service guardrails. Keep HOSTED_MODE=false for unrestricted self-hosting.
HOSTED_MODE=false
HOSTED_MAX_PARTICIPANTS=50

# Use production on a public deployment.
NODE_ENV=development

# Server Port (Optional - Render sets this automatically)
# PORT=3000
